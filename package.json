{
  "name": "career-hq",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "python scripts/privacy_scan.py . --release",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-bounded-dev-server.ps1",
    "dev:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-bounded-dev-server.ps1 -HoldAfterReadySeconds 0",
    "build": "next build",
    "postbuild": "python scripts/privacy_scan.py . --release",
    "start": "next start -H 127.0.0.1",
    "site:build": "npm --prefix site run build",
    "site:test": "npm --prefix site test",
    "test": "npm run build && node --test tests/*.test.mjs && python -m unittest discover -s tests -p \"test_*.py\" && npm run site:test && python scripts/privacy_scan.py . --release && python scripts/privacy_scan.py site/dist --release",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern site/dist --ignore-pattern site/.next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
