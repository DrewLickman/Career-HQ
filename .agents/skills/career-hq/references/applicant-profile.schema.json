{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-hq.example/schemas/applicant-profile.schema.json",
  "title": "Career HQ applicant profile",
  "type": "object",
  "required": ["schemaVersion", "identity", "searchDirection", "skills", "experience", "sources", "conflicts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "properties": {
        "mailingAddress": { "$ref": "#/$defs/mailingAddressEvidence" }
      },
      "additionalProperties": true
    },
    "searchDirection": { "type": "object" },
    "resumePreferences": {
      "type": "object",
      "properties": {
        "layoutProfile": { "$ref": "#/$defs/evidenceValue" }
      },
      "additionalProperties": true
    },
    "skills": { "type": "array" },
    "experience": { "type": "array" },
    "sources": { "type": "array" },
    "conflicts": { "type": "array" }
  },
  "additionalProperties": true,
  "$defs": {
    "evidenceValue": {
      "type": "object",
      "required": ["value", "source", "verifiedAt", "verified"],
      "properties": {
        "value": {}, "source": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date" }, "verified": { "type": "boolean" }
      }
    },
    "mailingAddressEvidence": {
      "type": "object",
      "required": ["value", "source", "verifiedAt", "verified"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["addressLine1", "city", "region", "postalCode", "country"],
              "properties": {
                "addressLine1": { "type": "string", "minLength": 1 },
                "addressLine2": { "type": "string" },
                "city": { "type": "string", "minLength": 1 },
                "region": { "type": "string", "minLength": 1 },
                "postalCode": { "type": "string", "minLength": 1 },
                "country": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date" },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
